# EC2'da /home/ubuntu/lamboerp/.env sifatida saqlang. Bu faylni GitHub'ga YUKLAMANG (.gitignore'da).
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=bu-yerga-uzun-tasodifiy-kalit
# EC2 public IP yoki domen (vergul bilan bir nechta)
DJANGO_ALLOWED_HOSTS=1.2.3.4
# HTTPS (sertifikat) bo'lmasa False — aks holda admin panelga kirib bo'lmaydi
DJANGO_SECURE_COOKIES=False

# Amazon RDS (PostgreSQL)
DB_HOST=lamboerp-db.xxxxxxxxxx.eu-central-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=lamboerp
DB_USER=lamboerp
DB_PASSWORD=rds-paroli
DB_SSLMODE=require

# Amazon S3 — access key YO'Q: ruxsat EC2'ga biriktirilgan IAM role orqali beriladi
AWS_STORAGE_BUCKET_NAME=lamboerp-docs-xxxx
AWS_S3_REGION_NAME=eu-central-1
